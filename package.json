{
  "name": "ciso-first-year",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b --noEmit && vite build",
    "preview": "vite preview --port 4173",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:soak": "vitest run tests/engine/soak.test.ts",
    "validate:content": "tsx scripts/validate-content.ts",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm validate:content && pnpm test",
    "test:e2e:local": "playwright test --project=desktop-chromium --project=tablet-portrait --project=tablet-landscape --project=phone --project=phone-320",
    "screenshots": "playwright test --config playwright.screenshots.config.ts --project=desktop-chromium --project=phone",
    "soak": "tsx scripts/soak.ts",
    "test:e2e:live": "playwright test --config playwright.live.config.ts",
    "coverage": "tsx scripts/coverage.ts",
    "size": "tsx scripts/size-budget.ts",
    "playthrough": "playwright test --config playwright.playthrough.config.ts --project=desktop-chromium",
    "play": "tsx scripts/play.ts",
    "ladder": "tsx scripts/ladder.ts"
  },
  "dependencies": {
    "@xyflow/react": "^12.11.6",
    "idb": "^8.0.3",
    "immer": "^11.1.18",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.1",
    "axe-core": "^4.13.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
